node_modules/
dist/
coverage/
.tmp/
*.tmp
stryker-setup-*.js
*.log
.DS_Store

# Crash artefacts. A killed child Raft node (SIGKILL during the chaos/e2e
# suites) drops a multi-hundred-megabyte core dump next to the package.
# The patterns are deliberately narrow: a bare `core` entry would also exclude
# every source directory named `core` (consensus/core, federation/src/core,
# operations/packages/core), which silently removed them from the repository.
/core
/core.[0-9]*
core.[0-9]*
*.core
*.heapsnapshot

# RaftGroup defaults its snapshot directory to ./data (cwd-relative), so running
# the cluster suites from the package directory leaves snapshot files behind.
cluster/data/

# Turbo build cache is a local artefact: committing it shipped stale, machine-specific
# task outputs and made "cache hit" results unverifiable in review.
.turbo/

# Stryker's working directory: a copy of the package plus its backups. Left
# behind by an interrupted run, it is 40 MB of duplicate sources that ESLint then
# tries to lint — the sandbox's own eslint.config.mjs imports a file one level
# up, which does not exist inside it.
.stryker-tmp/
**/reports/mutation/

# A mutant of AuditLogManager.flush() can let the suite's default-path case write,
# which is exactly what the mutation run is for; the artefact itself is not source.
audit.jsonl
