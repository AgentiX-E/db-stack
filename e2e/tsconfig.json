{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "harness/**/*.ts",
    "tests/**/*.ts",
    "bench/**/*.ts",
    "*.ts"
  ]
}
