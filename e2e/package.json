{
  "name": "@agentix-e/db-stack-e2e",
  "version": "1.1.0",
  "private": true,
  "description": "End-to-end acceptance tests: real multi-process Raft clusters over mTLS and cross-cluster federation over mTLS",
  "type": "module",
  "scripts": {
    "test": "vitest run tests/",
    "test:cluster": "vitest run tests/cluster-tls.test.ts",
    "test:federation": "vitest run tests/cross-cluster-sync.test.ts",
    "test:cdc": "vitest run tests/cdc-stream.test.ts tests/cdc-refusal.test.ts tests/cdc-ack.test.ts",
    "test:operations": "vitest run tests/operations-real-process.test.ts",
    "coverage": "vitest run --coverage",
    "bench": "tsx bench/real-ycsb.ts",
    "bench:all": "tsx bench/real-ycsb.ts --workload A,B,C,D,E,F --records 300 --ops 900 --threads 4",
    "test:engine": "vitest run tests/cluster-engine-durability.test.ts",
    "test:scaling": "vitest run tests/cluster-scaling.test.ts",
    "test:membership": "vitest run tests/cluster-membership.test.ts",
    "test:artefact": "vitest run tests/published-artefact.test.ts",
    "test:harness": "vitest run tests/harness-contract.test.ts",
    "lint": "eslint .",
    "format:check": "prettier --check \"harness/**/*.{ts,mjs}\" \"tests/**/*.ts\" \"bench/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:recovery": "vitest run tests/federation-recovery.test.ts"
  },
  "dependencies": {
    "@agentix-e/db-cluster": "workspace:*",
    "@agentix-e/db-federation": "workspace:*",
    "@agentix-e/db-node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "^5.7.3",
    "vitest": "3.2.6",
    "tsx": "^4.23.0"
  }
}
