-        const matchIdx = this.matchIndex.get(peerId);
-        const newNextIdx = Math.max(matchIdx + 1, currentNextIdx - 1);
+        // PATCH(db-stack): a rejection is evidence that matchIndex is wrong.
+        // The invariant "nextIndex > matchIndex" is derived from matchIndex, and a
+        // follower that answered "my log does not match at nextIndex - 1" does not
+        // hold the entries this leader believed it held. Clamping the decrement at
+        // the stale matchIndex pins nextIndex forever: a follower restarted on empty
+        // storage (match 4, log empty) leaves the leader at {next: 5, match: 4} for
+        // as long as it runs, because every rejection resolves back to 5.
+        // Lowering the bound first lets the probe walk back to where the follower
+        // actually is. It never raises matchIndex, so a healthy peer is unaffected.
+        const bound = Math.max(0, currentNextIdx - 2);
+        if (matchIdx > bound) this.matchIndex.set(peerId, bound);
+        const newNextIdx = Math.max(bound + 1, currentNextIdx - 1);
         this.nextIndex.set(peerId, newNextIdx);
     }
