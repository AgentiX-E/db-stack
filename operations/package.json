{
  "name": "@agentix-e/db-operations",
  "version": "2.0.0",
  "private": false,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.umbrella.json && node ../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.prod.json --noEmit",
    "typecheck:umbrella": "tsc -p tsconfig.umbrella.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"packages/*/src/__tests__/e2e/**\"",
    "test:integration": "vitest run packages/node/src/core/__tests__/e2e",
    "coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/test-report.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "clean": "rm -rf dist packages/*/dist coverage",
    "bench": "tsx bench/run-all.ts",
    "bench:ycsb": "tsx bench/ops-ycsb.ts",
    "test:mutation": "pnpm -w run test:mutation:operations"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/db-stack.git",
    "directory": "operations"
  },
  "description": "Unified, engine-agnostic database operations framework \u2014 three packages: node, cluster, federation",
  "keywords": [
    "database",
    "operations",
    "backup",
    "monitoring",
    "security",
    "audit",
    "metrics",
    "observability"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@agentix-e/db-operations-node": "workspace:*",
    "@agentix-e/db-operations-cluster": "workspace:*",
    "@agentix-e/db-operations-federation": "workspace:*"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ]
}
