{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "noUncheckedIndexedAccess": false
  },
  "include": ["packages/*/src/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
