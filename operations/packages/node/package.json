      "default": "./dist/maintenance/index.js"
    },
    "./memoryguard": {
      "types": "./dist/memoryguard/index.d.ts",
      "import": "./dist/memoryguard/index.js",
      "default": "./dist/memoryguard/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    },
    "./monitor": {
      "types": "./dist/monitor/index.d.ts",
      "import": "./dist/monitor/index.js",
      "default": "./dist/monitor/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js",
