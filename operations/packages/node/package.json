    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./slacollector": {
      "types": "./dist/slacollector/index.d.ts",
      "import": "./dist/slacollector/index.js",
      "default": "./dist/slacollector/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/fix-esm-extensions.mjs dist",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
