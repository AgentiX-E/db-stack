{
  "name": "@agentix-e/db-operations-node",
  "version": "2.0.0",
  "description": "Topology-agnostic operations primitives for a single database node — 20 modules",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js",
      "default": "./dist/core/types.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js",
      "default": "./dist/audit/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./autoscaler": {
      "types": "./dist/autoscaler/index.d.ts",
      "import": "./dist/autoscaler/index.js",
      "default": "./dist/autoscaler/index.js"
