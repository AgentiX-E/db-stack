{
  "name": "@agentix-e/db-operations-audit",
  "version": "1.3.0",
  "description": "Audit log and export abstractions for db-operations",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/fix-esm-extensions.mjs dist",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentix-e/db-operations-core": "workspace:*"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/db-stack.git",
    "directory": "operations/packages/audit"
  }
}
