{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@agentix-e/db-operations": [
        "./src/index.ts"
      ],
      "@agentix-e/db-operations-node": [
        "./packages/node/src/index.ts"
      ],
      "@agentix-e/db-operations-node/core/types": [
        "./packages/node/src/core/types.ts"
      ],
      "@agentix-e/db-operations-node/core": [
        "./packages/node/src/core/index.ts"
      ],
      "@agentix-e/db-operations-node/*": [
        "./packages/node/src/*/index.ts"
      ],
      "@agentix-e/db-operations-cluster": [
        "./packages/cluster/src/index.ts"
      ],
      "@agentix-e/db-operations-federation": [
        "./packages/federation/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
