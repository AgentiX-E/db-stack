{
  "name": "@agentix-e/db-node",
  "version": "2.0.0",
  "description": "Everything a single database node needs — operations, audit, backup, security, metrics — in one package with twenty subpaths",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js",
      "default": "./dist/core/types.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js",
      "default": "./dist/audit/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./autoscaler": {
      "types": "./dist/autoscaler/index.d.ts",
      "import": "./dist/autoscaler/index.js",
      "default": "./dist/autoscaler/index.js"
    },
    "./autotuner": {
      "types": "./dist/autotuner/index.d.ts",
      "import": "./dist/autotuner/index.js",
      "default": "./dist/autotuner/index.js"
    },
    "./backup": {
      "types": "./dist/backup/index.d.ts",
      "import": "./dist/backup/index.js",
      "default": "./dist/backup/index.js"
    },
    "./chaosengine": {
      "types": "./dist/chaosengine/index.d.ts",
      "import": "./dist/chaosengine/index.js",
      "default": "./dist/chaosengine/index.js"
    },
    "./circuitbreaker": {
      "types": "./dist/circuitbreaker/index.d.ts",
      "import": "./dist/circuitbreaker/index.js",
      "default": "./dist/circuitbreaker/index.js"
    },
    "./configwatcher": {
      "types": "./dist/configwatcher/index.d.ts",
      "import": "./dist/configwatcher/index.js",
      "default": "./dist/configwatcher/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js",
      "default": "./dist/health/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js",
      "default": "./dist/logger/index.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance/index.d.ts",
      "import": "./dist/maintenance/index.js",
      "default": "./dist/maintenance/index.js"
    },
    "./memoryguard": {
      "types": "./dist/memoryguard/index.d.ts",
      "import": "./dist/memoryguard/index.js",
      "default": "./dist/memoryguard/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "default": "./dist/metrics/index.js"
    },
    "./monitor": {
      "types": "./dist/monitor/index.d.ts",
      "import": "./dist/monitor/index.js",
      "default": "./dist/monitor/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js",
      "default": "./dist/otel/index.js"
    },
    "./rollingupgrade": {
      "types": "./dist/rollingupgrade/index.d.ts",
      "import": "./dist/rollingupgrade/index.js",
      "default": "./dist/rollingupgrade/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./slacollector": {
      "types": "./dist/slacollector/index.d.ts",
      "import": "./dist/slacollector/index.js",
      "default": "./dist/slacollector/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node ../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.prod.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/core/__tests__/e2e/**\"",
    "test:integration": "vitest run src/core/__tests__/e2e",
    "coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/test-report.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "bench": "tsx bench/run-all.ts",
    "bench:ycsb": "tsx bench/ops-ycsb.ts",
    "test:mutation": "pnpm -w run test:mutation:node"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/lib-storage": "^3.1089.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/lib-storage": "^3.1089.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/lib-storage": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/db-stack.git",
    "directory": "node"
  },
  "keywords": [
    "database",
    "operations",
    "single-node",
    "backup",
    "monitoring",
    "security",
    "audit",
    "metrics",
    "observability"
  ]
}
