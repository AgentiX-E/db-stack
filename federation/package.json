{
  "name": "@agentix-e/db-federation",
  "version": "1.1.0",
  "description": "Cross-cluster data federation: CDC, outbox replication, conflict resolution and anti-entropy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"src/__tests__/integration/**\" --exclude \"src/__tests__/chaos/**\" --exclude \"src/__tests__/performance/**\"",
    "test:integration": "vitest run src/__tests__/integration src/__tests__/chaos",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage",
    "bench": "tsx bench/run-all.ts",
    "bench:ycsb": "tsx bench/federation-ycsb.ts",
    "docs": "typedoc",
    "test:perf": "vitest run --testTimeout=1800000 src/__tests__/performance",
    "test:mutation": "pnpm -w run test:mutation:federation"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "database",
    "federation",
    "cdc",
    "replication",
    "multi-datacenter",
    "conflict-resolution"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/TcpSecureTransport.d.ts",
      "import": "./dist/transport/TcpSecureTransport.js",
      "default": "./dist/transport/TcpSecureTransport.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/db-stack.git",
    "directory": "federation"
  },
  "dependencies": {
    "@agentix-e/db-cluster": "workspace:*",
    "lmdb": "^3.2.6",
    "zeromq": "^6.2.1"
  },
  "devDependencies": {
    "@agentix-e/db-operations-audit": "workspace:*",
    "@agentix-e/db-operations-backup": "workspace:*",
    "@agentix-e/db-operations-observability": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.6"
  }
}
