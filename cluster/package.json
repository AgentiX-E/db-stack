{
  "name": "@agentix-e/db-cluster",
  "version": "1.2.1",
  "description": "Database cluster orchestration layer with Raft consensus, WAL, sharding, and HA",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bench": "tsx bench/run-all.ts",
    "bench:concurrency": "tsx bench/proposal-concurrency-curve.ts",
    "bench:snapshot": "tsx bench/snapshot-threshold-sweep.ts",
    "bench:ycsb": "tsx bench/raft-ycsb.ts",
    "build": "tsc -p tsconfig.build.json && node ../scripts/fix-esm-extensions.mjs dist",
    "clean": "rm -rf dist coverage",
    "coverage": "vitest run --coverage",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration src/__tests__/chaos src/__tests__/linearizability src/__tests__/snapshot src/__tests__/shard src/__tests__/consensus",
    "test:load": "vitest run --testTimeout=1800000 src/__tests__/boundary",
    "test:mutation": "pnpm -w run test:mutation:cluster",
    "test:perf": "NODE_OPTIONS=--expose-gc vitest run --config vitest.performance.config.ts",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:unit": "vitest run --exclude \"src/__tests__/integration/**\" --exclude \"src/__tests__/chaos/**\" --exclude \"src/__tests__/linearizability/**\" --exclude \"src/__tests__/snapshot/**\" --exclude \"src/__tests__/shard/**\" --exclude \"src/__tests__/consensus/**\" --exclude \"src/__tests__/boundary/**\"",
    "tla-check": "bash tla/tla-check.sh",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "database",
    "cluster",
    "raft",
    "sharding",
    "high-availability"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./raft": {
      "types": "./dist/consensus/core/RaftAdapter.d.ts",
      "import": "./dist/consensus/core/RaftAdapter.js",
      "default": "./dist/consensus/core/RaftAdapter.js"
    },
    "./transport": {
      "types": "./dist/consensus/transport/RaftTcpTransport.d.ts",
      "import": "./dist/consensus/transport/RaftTcpTransport.js",
      "default": "./dist/consensus/transport/RaftTcpTransport.js"
    },
    "./storage": {
      "types": "./dist/consensus/storage/SqliteStorage.d.ts",
      "import": "./dist/consensus/storage/SqliteStorage.js",
      "default": "./dist/consensus/storage/SqliteStorage.js"
    },
    "./shard": {
      "types": "./dist/interfaces/shard/index.d.ts",
      "import": "./dist/interfaces/shard/index.js",
      "default": "./dist/interfaces/shard/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/db-stack.git",
    "directory": "cluster"
  },
  "dependencies": {
    "@agentix-e/db-operations-node": "workspace:*",
    "@maboke123/raft-core": "^0.2.1",
    "@msgpack/msgpack": "^3.1.3",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "buffer-crc32": "^1.0.0",
    "node-forge": "^1.4.0",
    "opossum": "^10.0.0",
    "pino": "^9.0.0"
  },
  "optionalDependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.15.0",
    "@types/node-forge": "^1.3.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.6.0",
    "knip": "^6.25.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "3.2.6"
  }
}
