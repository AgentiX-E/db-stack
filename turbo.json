{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": [],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [],
      "outputs": []
    },
    "coverage": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "bench": {
      "cache": false,
      "outputs": []
    }
  }
}
