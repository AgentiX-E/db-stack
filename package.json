{
  "name": "db-stack",
  "version": "1.1.0",
  "private": true,
  "description": "AgentiX-E database stack — cluster (Raft consensus), federation (cross-cluster sync) and operations (ops framework) as a single monorepo",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "typecheck:tests": "turbo run typecheck:tests",
    "lint": "turbo run lint",
    "format:check": "turbo run format:check",
    "format:check:repo": "prettier --check \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.mjs\" \"*.json\" \"*.md\"",
    "test": "turbo run test --filter=!@agentix-e/db-stack-e2e",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "coverage": "turbo run coverage --filter=!@agentix-e/db-stack-e2e",
    "coverage:e2e": "pnpm --filter @agentix-e/db-stack-e2e run coverage",
    "coverage:all": "pnpm coverage && pnpm coverage:e2e",
    "coverage:gate": "node scripts/coverage-gate.mjs",
    "e2e": "pnpm --filter @agentix-e/db-stack-e2e run test:harness && pnpm --filter @agentix-e/db-stack-e2e run test:artefact && pnpm --filter @agentix-e/db-stack-e2e run test:cluster && pnpm --filter @agentix-e/db-stack-e2e run test:membership && pnpm --filter @agentix-e/db-stack-e2e run test:engine && pnpm --filter @agentix-e/db-stack-e2e run test:federation",
    "bench": "turbo run bench",
    "verify": "pnpm check:gates && pnpm check:english && pnpm check:esm-require && pnpm check:docs-api && pnpm check:doc-examples && pnpm check:public-types && pnpm check:script-bins && pnpm test:scripts && pnpm lint && pnpm format:check && pnpm format:check:repo && pnpm typecheck && pnpm typecheck:tests && pnpm coverage:all && pnpm coverage:gate && pnpm check:test-counts && pnpm check:script-coverage && pnpm e2e",
    "bench:real": "pnpm --filter @agentix-e/db-stack-e2e run bench",
    "check:package": "node scripts/check-package.mjs",
    "check:gates": "node scripts/check-gates.mjs",
    "check:english": "node scripts/check-english.mjs",
    "check:esm-require": "node scripts/check-esm-require.mjs",
    "check:docs-api": "node scripts/check-docs-api.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:test-counts": "node scripts/check-test-counts.mjs",
    "check:script-coverage": "node scripts/check-script-coverage.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:soak": "pnpm --filter @agentix-e/db-cluster run test:soak",
    "test:load": "pnpm --filter @agentix-e/db-cluster run test:load && pnpm --filter @agentix-e/db-federation run test:perf",
    "test:mutation": "node scripts/mutation.mjs all",
    "test:perf": "pnpm --filter @agentix-e/db-cluster run test:perf && pnpm --filter @agentix-e/db-stack-e2e run bench",
    "test:mutation:cluster": "node scripts/mutation.mjs cluster",
    "test:mutation:federation": "node scripts/mutation.mjs federation",
    "test:mutation:operations": "node scripts/mutation.mjs operations",
    "audit:policy": "node scripts/audit-policy.mjs",
    "check:mutation-timeouts": "node operations/scripts/resolve-timeouts.mjs --check --all",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:script-bins": "node scripts/check-script-bins.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^10.15.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "@vitest/coverage-v8": "3.2.6",
      "@vitest/expect": "3.2.6",
      "@vitest/runner": "3.2.6",
      "@vitest/snapshot": "3.2.6",
      "@vitest/spy": "3.2.6",
      "@vitest/utils": "3.2.6",
      "@vitest/mocker": "3.2.6",
      "@vitest/pretty-format": "3.2.6",
      "tinypool": "2.2.0"
    },
    "patchedDependencies": {
      "@maboke123/raft-core@0.2.1": "patches/@maboke123__raft-core@0.2.1.patch"
    }
  },
  "auditPolicy": {
    "allow": []
  }
}
